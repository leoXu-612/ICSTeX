.latex_build/
.icstex/

# Local virtualenvs
.venv/
venv/
env/
.env
.env.*
!.env.example
*.pem
*.key
credentials.json

# Test / coverage
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.ruff_cache/
