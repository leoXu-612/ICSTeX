output/playwright/

# Native probe screenshots include machine-local temporary paths and raw logs.
# Keep originals locally; publish the measurement JSON and reproduction script.
docs/data/pdf-pipeline-2026-09-08/*.png

# Large Windows distribution artifact (regenerated by packaging/build_windows.bat)
ICSTeX-Windows.zip
ICSTeX-Setup.exe

# AgentBridge runtime state (locks, tmp, claims, workflows)
.agentbridge/

# Codex local watch state
.codex_watch_state

# Large release binaries (regenerated by packaging/build_macos.sh)
release/*.dmg
release/*.zip
