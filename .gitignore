# Build / distribution artifacts
build/
dist/
*.egg-info/
*.egg

# PyInstaller intermediates
*.spec.bak
packaging/__pycache__/

# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
.claude/
*.swp

